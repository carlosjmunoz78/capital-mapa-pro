{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEREBRO Engine Manifest V0",
  "type": "object",
  "required": ["engine_id","name","company_scope","environment","version","status","owner","inputs","outputs","permissions","policies","events_in","events_out","tests","evaluation","observability","cost_budget","backup","rollback","rebuild","dependencies","autonomy_level","human_exception_codes"],
  "properties": {
    "engine_id": {"type":"string","minLength":3},
    "name": {"type":"string","minLength":1},
    "company_scope": {"enum":["GLOBAL_ONLY","GLOBAL_OR_SCOPED","COMPANY_SCOPED"]},
    "environment": {"enum":["LAB","PREPROD","PROD"]},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum":["CONFIRMED_OPERATIONAL","DOCUMENTED_PARTIAL","DEFINED_NOT_BUILT","PROPOSED","UNKNOWN_REQUIRES_AUDIT"]},
    "owner": {"type":"string"},
    "inputs": {"type":"array"},
    "outputs": {"type":"array"},
    "permissions": {"type":"array"},
    "policies": {"type":"array"},
    "events_in": {"type":"array"},
    "events_out": {"type":"array"},
    "tests": {"type":"array"},
    "evaluation": {"type":"array"},
    "observability": {"type":"array"},
    "cost_budget": {"type":"object"},
    "backup": {"type":"object"},
    "rollback": {"type":"object"},
    "rebuild": {"type":"object"},
    "dependencies": {"type":"array"},
    "autonomy_level": {"type":"string"},
    "human_exception_codes": {
      "type":"array",
      "items":{"enum":["LEGAL_REQUIRED","SIGNATURE_REQUIRED","LOW_CONFIDENCE","HIGH_RISK","POLICY_CONFLICT","SECURITY_INCIDENT","MONEY_LIMIT","CUSTOMER_HUMAN_REQUEST"]}
    }
  },
  "additionalProperties": true
}
